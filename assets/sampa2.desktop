[Desktop Entry]
Type=Application
Version=1.0
Name=Sampa2
GenericName=Terminal
Comment=Native GPU terminal (winit + wgpu)
Exec=sampa2
Icon=sampa2
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;prompt;console;command;
StartupNotify=true
StartupWMClass=sampa2
# xdg-terminal-exec (freedesktop default-terminal spec): how to drive sampa2 as the
# user's terminal — each key names the flag for a capability. These match the sampa-cli
# flags the native build wires up.
X-TerminalArgExec=-e
X-TerminalArgTitle=--title
X-TerminalArgAppId=--class
X-TerminalArgDir=--working-directory
X-TerminalArgHold=--hold
Actions=new-window;edit-config;

[Desktop Action new-window]
Name=New Window
Exec=sampa2

[Desktop Action edit-config]
Name=Edit Config
Exec=sampa2 --title "Sampa2 Config" -e sh -c "\${EDITOR:-nano} \$HOME/.config/sampa2/config.toml"
